# Public
NEXT_PUBLIC_SITE_URL=

# Supabase (admin CMS). Public URL/publishable key are safe for the browser;
# the service-role key is SERVER-ONLY and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only contact delivery (Resend)
# Never commit real values. See docs for provider setup.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
